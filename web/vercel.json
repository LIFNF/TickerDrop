{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
    ] }
  ],
  "rewrites": [
    { "source": "/engine", "destination": "/index.html" },
    { "source": "/cutoff", "destination": "/index.html" },
    { "source": "/mint", "destination": "/index.html" },
    { "source": "/book", "destination": "/index.html" },
    { "source": "/vault", "destination": "/index.html" },
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/t/:symbol", "destination": "/index.html" }
  ]
}
